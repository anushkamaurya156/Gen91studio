# TinaCMS Cloud Authentication (Get these from https://app.tina.io)
TINA_CLIENT_ID=your_tina_client_id_here
TINA_TOKEN=your_tina_token_here
VITE_TINA_CLIENT_ID=your_tina_client_id_here
VITE_TINA_TOKEN=your_tina_token_here

# Local Development Flag (set to 'true' locally for offline edits; omit or set to 'false' on Vercel)
TINA_PUBLIC_IS_LOCAL=true
